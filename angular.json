{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "calendario": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "skipTests": true
        },
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "@fontsource/montserrat/300.css",
              "@fontsource/montserrat/400.css",
              "@fontsource/montserrat/500.css",
              "@fontsource/montserrat/600.css",
              "@fontsource/montserrat/700.css",
              "@fontsource/dancing-script/400.css",
              "@fontsource/dancing-script/600.css",
              "@fontsource/allura/400.css",
              "@fontsource/poppins/300.css",
              "@fontsource/poppins/400.css",
              "@fontsource/poppins/600.css",
              "@fontsource/raleway/300.css",
              "@fontsource/raleway/400.css",
              "@fontsource/raleway/600.css",
              "@fontsource/lato/300.css",
              "@fontsource/lato/400.css",
              "@fontsource/lato/700.css",
              "@fontsource/josefin-sans/300.css",
              "@fontsource/josefin-sans/400.css",
              "@fontsource/josefin-sans/600.css",
              "@fontsource/quicksand/300.css",
              "@fontsource/quicksand/400.css",
              "@fontsource/quicksand/600.css",
              "@fontsource/nunito/300.css",
              "@fontsource/nunito/400.css",
              "@fontsource/nunito/600.css",
              "@fontsource/playfair-display/400.css",
              "@fontsource/playfair-display/600.css",
              "@fontsource/lora/400.css",
              "@fontsource/lora/600.css",
              "@fontsource/great-vibes/400.css",
              "@fontsource/sacramento/400.css",
              "@fontsource/pacifico/400.css",
              "@fontsource/satisfy/400.css",
              "@fontsource/caveat/400.css",
              "@fontsource/parisienne/400.css",
              "src/styles.scss"
            ],
            "allowedCommonJsDependencies": [
              "raf",
              "rgbcolor",
              "core-js",
              "html2canvas",
              "canvg",
              "dompurify"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "800kB",
                  "maximumError": "1.5MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "12kB",
                  "maximumError": "24kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "calendario:build:production"
            },
            "development": {
              "buildTarget": "calendario:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}